# Copiá este archivo como ".env" y completá tus claves.
# El .env real NUNCA se sube a GitHub (está en .gitignore).

# --- LLM -------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURA=0
LLM_TIMEOUT_S=60
LLM_MAX_REINTENTOS=3

# --- Embeddings (siempre OpenAI, aunque el LLM sea Anthropic) ---------------
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Infraestructura -------------------------------------------------------
# Con Docker Compose estas tres se pisan solas (ver docker-compose.yml).
REDIS_URL=redis://localhost:6379
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLECCION=noticias_ia

# --- RAG -------------------------------------------------------------------
RAG_K=5
RAG_CANDIDATOS=20
RAG_RRF_K=60
# Similitud coseno mínima para considerar relevante un fragmento.
# Calibrar con: docker compose exec api python -m scripts.evaluar_rag
RAG_UMBRAL_SIMILITUD=0.30
RAG_CHUNK_TOKENS=160
RAG_CHUNK_SOLAPAMIENTO=40

# --- Orquestación ----------------------------------------------------------
MAX_PASOS=10
MAX_INTENTOS_INVESTIGACION=2
TIMEOUT_JOB_SEGUNDOS=300

# --- Observabilidad (LangSmith) --------------------------------------------
# Key en https://smith.langchain.com -> Settings -> API Keys (empieza con lsv2_pt_)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=ai-news-intelligence
# Cuenta en la región EU: descomentar
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LOG_LEVEL=INFO
